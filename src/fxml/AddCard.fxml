<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="700.0" styleClass="add-card-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CardCreateController">

    <children>

        <BorderPane maxHeight="700.0" maxWidth="700.0" minHeight="700.0" minWidth="750.0" styleClass="add-card-children">

            <top>

                <VBox alignment="CENTER" spacing="5">

                    <padding>
                        <Insets bottom="15" left="20" right="20" top="20" />
                    </padding>

                    <Label fx:id="labelTitle" style="-fx-text-fill: white;                                   -fx-font-size: 26px;                                                                                                              -fx-font-weight: bold;                                                                                                           " text="CREATE NEW CARD" />

                    <Label fx:id="labelSecondaryTitle" style="-fx-text-fill: #9da9c9;                                                                                             -fx-font-size: 13px;" text="Add a new card to your category" />
                </VBox>

            </top>

            <center>

                <HBox alignment="CENTER" spacing="25">

                    <padding>
                        <Insets bottom="10" left="25" right="25" top="10" />
                    </padding>

                    <VBox alignment="CENTER" prefWidth="230" spacing="12" style="                      -fx-background-color: rgba(255,255,255,0.06);                                                                               -fx-background-radius: 15;                                                                               -fx-border-color: rgba(255,255,255,0.12);                                                                               -fx-border-radius: 15;">

                        <padding>
                            <Insets bottom="15" left="15" right="15" top="15" />
                        </padding>

                        <Label fx:id="labelCardPreview" style=" -fx-text-fill: #9da9c9;                                         -fx-font-size: 12px;                                           -fx-font-weight: bold;" text="CARD PREVIEW" />
                                       

                        <StackPane prefHeight="190" prefWidth="190" style="-fx-background-color: rgba(0,0,0,0.35);                                                                                          -fx-background-radius: 12;                                                                                          -fx-border-color: rgba(255,255,255,0.15);                                                                                          -fx-border-radius: 12;">
                 
                            <ImageView fx:id="imagePreview" fitHeight="175" fitWidth="175" preserveRatio="true" />

                            <Label fx:id="imagePlaceholder" style=" -fx-text-fill: #68738f;                                                                                                  -fx-font-size: 12px;" text="No image selected" />

                        </StackPane>

                        <Button fx:id="btnSelectImage" onAction="#selectImage" prefWidth="170" styleClass="editor-button" text="Select Image" />

                        <Button fx:id="btnSelectSound" onAction="#selectSound" prefWidth="170" styleClass="editor-button" text="Select Sound" />

                        <Label fx:id="soundLabel" style="-fx-text-fill: #68738f;                                                                                      -fx-font-size: 11px;" text="No sound selected" wrapText="true" />

                    </VBox>

                    <VBox prefWidth="310" spacing="15">

                        <Label fx:id="boxLabelCategory" styleClass="section-label" text="Category" textFill="WHITE" />

                        <HBox spacing="8">

                            <ComboBox fx:id="categoryComboBox" prefHeight="26.0" prefWidth="312.0" />

                        </HBox>

                        <Label fx:id="boxLableCard" styleClass="section-label" text="Card Title" textFill="WHITE" />

                        <TextField fx:id="titleField" prefHeight="40" styleClass="editor-text-field" />

                        <Label fx:id="boxLabelDescription" styleClass="section-label" text="Description" textFill="WHITE" />

                        <TextArea fx:id="descriptionField" prefHeight="150.0" prefWidth="310.0" styleClass="editor-text-area" wrapText="true" />
                        
                  <Label fx:id="boxLabelLang" layoutX="10.0" layoutY="84.0" styleClass="section-label" text="Translation Language" textFill="WHITE" />
                  <ComboBox fx:id="languageComboBox" prefHeight="26.0" prefWidth="312.0" />
                  <Label fx:id="boxLabelTranslation" layoutX="10.0" layoutY="228.0" styleClass="section-label" text="Translation" textFill="WHITE" />
                  <TextField fx:id="languageField" layoutX="10.0" layoutY="117.0" prefHeight="40" styleClass="editor-text-field" />
                   
                  <Label fx:id="boxLabelDescription2" layoutX="10.0" layoutY="163.0" styleClass="section-label" text="Description" textFill="WHITE" />
                  <TextArea fx:id="tDescriptionField" layoutX="10.0" layoutY="205.0" prefHeight="150.0" prefWidth="310.0" styleClass="editor-text-area" wrapText="true">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </TextArea>
                        <Label fx:id="messageLabel" style="-fx-text-fill: #ff7070;                                                                                      -fx-font-size: 12px; " wrapText="true" />

                    </VBox>

                </HBox>

            </center>


            <bottom>

                <HBox alignment="CENTER_RIGHT" spacing="12">

                    <padding>
                        <Insets bottom="20" left="25" right="25" top="15" />
                    </padding>

                    <Button fx:id="btnCancel" onAction="#cancel" prefWidth="110" styleClass="primary-button" text="Cancel" />

                    <Button fx:id="btnCreateCard" onAction="#createCard" prefWidth="150" styleClass="primary-button" text="Create Card" />

                </HBox>

            </bottom>

        </BorderPane>

    </children>

</StackPane>
