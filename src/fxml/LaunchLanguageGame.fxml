<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" prefHeight="600.0" prefWidth="700.0" styleClass="card-editor-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LanguageLearnLaunchController">

    <children>

        <BorderPane maxHeight="600.0" maxWidth="700.0" minHeight="600.0" minWidth="700.0" styleClass="card-editor-container">
            <top>

                <VBox alignment="CENTER" spacing="6">

                    <padding>
                        <Insets bottom="20" left="20" right="20" top="25" />
                    </padding>

                    <Label fx:id="labelTitle" styleClass="editor-title" text="LANGUAGE LEARNING" textFill="WHITE" />

                    <Label fx:id="labelSubTitile" styleClass="editor-subtitle" textFill="WHITE" />

                </VBox>

            </top>

            <center>

                <VBox alignment="CENTER" spacing="18">

                    <padding>
                        <Insets bottom="20" left="60" right="60" top="20" />
                    </padding>

                    <VBox alignment="CENTER" maxWidth="560.0" spacing="15" styleClass="preview-panel">

                        <padding>
                            <Insets bottom="25" left="30" right="30" top="25" />
                        </padding>


                        <Label fx:id="labelHowTo" styleClass="preview-title" text="HOW TO PLAY" textFill="WHITE" />


                        <Label styleClass="rule-number" text="1" />

                        <Label fx:id="labelRule1" alignment="CENTER" minHeight="20.0" minWidth="600.0" styleClass="rule-text" text="rule 1 " wrapText="true" />


                        <Label styleClass="rule-number" text="2" />

                        <Label fx:id="labelRule2" alignment="CENTER" minWidth="600.0" styleClass="rule-text" text="rule 2" wrapText="true" />


                        <Label styleClass="rule-number" text="3" />

                        <Label fx:id="labelRule3" alignment="CENTER" minWidth="600.0" styleClass="rule-text" text="rule 3" wrapText="true" />


                        <Label styleClass="rule-number" text="4" />

                        <Label fx:id="labelRule4" alignment="CENTER" minWidth="600.0" styleClass="rule-text" text="rule 4 " wrapText="true" />


                        <Label styleClass="rule-number" text="5" />

                        <Label fx:id="labelRule5" alignment="CENTER" minWidth="600.0" styleClass="rule-text" text="rule 5" wrapText="true" />

                    </VBox>

                </VBox>

            </center>

            <bottom>

                <HBox alignment="CENTER" spacing="12">

                    <padding>
                        <Insets bottom="30" left="25" right="25" top="15" />
                    </padding>

                    <Button fx:id="startButton" onAction="#startGame" prefHeight="45" prefWidth="180" styleClass="primary-button" text="START GAME" />

                </HBox>

            </bottom>

        </BorderPane>

    </children>

</StackPane>
