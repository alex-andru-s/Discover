<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="collection-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CardsCollectionController">

    <VBox alignment="TOP_CENTER" fillWidth="true" spacing="20">

        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <Label fx:id="labelTitle" styleClass="collection-title" text="My Collection" />

        <Label fx:id="countLabel" styleClass="collection-count" text="Learned Cards: 0" />

        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="collection-scroll" vbarPolicy="AS_NEEDED">

            <content>

                <FlowPane fx:id="cardsContainer" alignment="TOP_CENTER" hgap="20" prefWrapLength="500" vgap="20">
               <padding>
                  <Insets top="10.0" />
               </padding></FlowPane>

            </content>

        </ScrollPane>

        <Label fx:id="emptyLabel" styleClass="collection-empty" visible="false" />

    </VBox>

</StackPane>
