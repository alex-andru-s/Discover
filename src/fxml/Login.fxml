<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" prefHeight="700.0" prefWidth="800.0"
 xmlns="http://javafx.com/javafx/21" 
 xmlns:fx="http://javafx.com/fxml/1" 
 fx:controller="controller.LoginController">
    
    <children>
      <VBox prefHeight="200.0" prefWidth="100.0">
         <children>
            <Region prefHeight="250.0" prefWidth="800.0" />
      
              <VBox alignment="CENTER" prefHeight="520.0" prefWidth="658.0" spacing="20.0" styleClass="center-menu">
      
                  <Label prefHeight="99.0" prefWidth="130.0" style="-fx-font-size: 30px;                        -fx-font-weight: bold;" text="Discover" textAlignment="CENTER" textFill="#0000009c">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Label>
      
                  <Button fx:id="guest" minHeight="26.0" minWidth="165.0" onAction="#loginGuest" styleClass="primary-button" textAlignment="CENTER" textFill="WHITE" />
      
                  <Button fx:id="loadPlayer" minHeight="26.0" minWidth="165.0" onAction="#loadPlayer" styleClass="primary-button" textAlignment="CENTER" textFill="WHITE" />
      
                  <Button fx:id="createPlayer" minHeight="26.0" minWidth="165.0" onAction="#createPlayer" styleClass="primary-button" textAlignment="CENTER" textFill="WHITE" />
               <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="125.0" prefWidth="700.0" />
               <Button fx:id="selectLanguage" layoutX="328.0" layoutY="232.0" minHeight="30.0" minWidth="30.0" onAction="#languageSelect" style="-fx-background-radius: 30;" styleClass="language-button" textAlignment="CENTER" textFill="WHITE">
                  <graphic>
                     <ImageView fx:id="languageImage" fitHeight="30.0" fitWidth="30.0" focusTraversable="true" nodeOrientation="INHERIT" pickOnBounds="true" style="-fx-background-radius: 30;" />
                  </graphic></Button>
               <Button fx:id="quit" minHeight="26.0" minWidth="165.0" onAction="#closeGame" styleClass="close-button" textFill="#866767">
                  <effect>
                     <Blend />
                  </effect>
                  <VBox.margin>
                     <Insets />
                  </VBox.margin>
               </Button>
      
              </VBox>
         </children>
      </VBox>

    </children>

</StackPane>
