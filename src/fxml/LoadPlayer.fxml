<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="250.0" prefWidth="350.0" 
spacing="15" 
styleClass="root" 
xmlns="http://javafx.com/javafx/21" 
xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="controller.LoginController">

    <children>

        <Label fx:id="labelLoad" styleClass="title-label" textFill="#babcbf">
         <VBox.margin>
            <Insets top="25.0" />
         </VBox.margin></Label>

        <TextField fx:id="textField" focusTraversable="false" minWidth="300.0" prefHeight="30.0" prefWidth="300.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets bottom="-20.0" left="50.0" right="50.0" top="10.0" />
         </VBox.margin></TextField>

        <Label fx:id="labelMessage" alignment="CENTER" contentDisplay="CENTER" minWidth="300.0" prefHeight="35.0" prefWidth="300.0" styleClass="messageLabel" text="" wrapText="true">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin></Label>

        <Button fx:id="enter" onAction="#login" prefWidth="200.0" styleClass="primary-button" textFill="#5b5b5e" />

        <Button fx:id="cancel" onAction="#back" prefWidth="200.0" styleClass="secondary-button" textFill="#5b5b5e">
         <VBox.margin>
            <Insets bottom="25.0" />
         </VBox.margin></Button>

    </children>

</VBox>
